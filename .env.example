# MAGI System API Keys
# Copy this file to .env and fill in your API keys
# Note: For security, API keys are stored in browser localStorage, not environment variables

# Anthropic Claude API Key (for MELCHIOR)
# Get it from: https://console.anthropic.com/
VITE_CLAUDE_API_KEY=your_claude_api_key_here

# OpenAI API Key (for BALTHASAR)
# Get it from: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key (for CASPER)
# Get it from: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here
